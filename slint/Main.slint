import { Error, ErrorPopup } from "./Error.slint";
import { Functions } from "./Functions.slint";
import { Game } from "./Game.slint";
import { Team, Shot, NewGameParameters, GameModel, Player, PlayerSkills, PlayingTeam } from "./GameModel.slint";
import { Ice } from "./Ice.slint";
import { Profiles } from "./Profiles.slint";
import { LoadPanel, SaveLoad } from "./SaveLoad.slint";
import { StoneModel, SheetEndGeometry, SheetGeometry, SheetModel } from "./SheetModel.slint";
import { NewGame } from "./NewGame.slint";
import { TabWidget } from "std-widgets.slint";

export {
    Error,
    Functions,
    GameModel,
    NewGameParameters,
    Player,
    PlayerSkills,
    Profiles,
    SaveLoad,
    SheetModel,
    SheetEndGeometry,
    SheetGeometry,
    Shot,
    StoneModel,
    Team
}

export component Main inherits Window {
    in property <bool> blinking-stone-visible;
    in property <NewGameParameters> default-game-parameters;
    in property <bool> rebounding;

    preferred-width: 1000px;
    preferred-height: 800px;
    title: "Gielo";

    if !rebounding: tabs := TabWidget {
        Tab {
            title: "New Game";

            NewGame {
                parameters: default-game-parameters;

                game-started => {
                    tabs.current-index = 1;
                }
            }
        }
        Tab {
            title: "Current Game";

            Game {
                blinking-stone-visible: root.blinking-stone-visible;
            }
        }
        Tab {
            title: "Load Game";

            LoadPanel {
                game-loaded => {
                    tabs.current-index = 1
                }
            }
        }
    }

    error-popup := ErrorPopup {
        x: root.width / 2 - self.width / 2;
        y: 0;
    }
}