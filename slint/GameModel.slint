import { SheetModel, StoneModel } from "./SheetModel.slint";

export struct Player := {
    skill-profile: int,
    left-handed: bool,
}

export struct NewGameTeam := {
    name: string,
    color: color,
    players: [Player],
}

export struct NewGameParameters := {
    ends: int,
    teams: [NewGameTeam],
    ice-profile: int,
    rules-profile: int,
}

export struct Team := {
    name: string,
    color: color,
    first-hammer: bool,
    stones-left: int,
    end-score: [int],
    score: int,
}

export global Shot := {
    property <float> weight-sec: 3.0;
    property <float> mark-x: 0.0;
    property <float> mark-y: SheetModel.geometry.playing-end.tee-y;
    property <bool> clockwise: true;

    property <string> preview-commands;
    property <StoneModel> preview-result;

    callback update-preview();
}

export global GameModel := {
    property <[Team]> teams;
    property <int> end;
    property <int> ends;
    property <int> current-team;
    property <bool> game-running;
    property <bool> thinking;
    property <bool> delivering;
    property <bool> fgz-rule-violated;
    property <bool> no-tick-rule-violated;
    property <bool> end-finished;
    property <int> end-score;
    property <bool> game-finished;

    callback start-new-game(NewGameParameters);
    callback finish-game();
    callback deliver();
    callback proceed();
    callback replace-stones();
}
