import { Functions } from "./Functions.slint";
import { Shot } from "./GameModel.slint";
import { SheetModel } from "./SheetModel.slint";
import { Ice } from "./Ice.slint";
import { ScrollView, Slider } from "std-widgets.slint";

Mark := Rectangle {
    x: Shot.mark-x * SheetModel.pixels-per-foot + SheetModel.geometry-px.tee-x - width / 2.0;
    y: Shot.mark-y * SheetModel.pixels-per-foot;
    width: 18px;
    height: 1.8 * width;
    background: orange;
    border-radius: width / 2.0;
    border-color: black;
    border-width: 2px;

    Rectangle {
        x: (parent.width - width) / 2.0;
        y: parent.height;
        width: 8px;
        height: 80px;
        background: black;

        Rectangle {
            x: (Shot.clockwise ? 10px : -width - 10px) + parent.width / 2.0;
            y: parent.height - height;
            width: 40px;
            height: 8px;
            border-radius: height / 2.0;
            background: gray;

            Rectangle {
                x: (Shot.clockwise ? parent.width : 0.0) - width / 2.0;
                y: (parent.height - height) / 2.0;
                width: 18px;
                height: width;
                background: white;
                border-radius: width / 2.0;
                border-color: gray;
                border-width: 2px;
            }
        }
    }
}

export Sheet := Flickable {
    width: ice.width;
    viewport-width: ice.width;
    viewport-height: ice.height;
    viewport-y: height - SheetModel.geometry-px.playing-end.back-y - 60.px;

    ice := Ice {}

    for stone in SheetModel.stones: Rectangle {
        x: stone.x * SheetModel.pixels-per-foot + SheetModel.geometry-px.tee-x - border-radius;
        y: stone.y * SheetModel.pixels-per-foot - border-radius;
        border-radius: SheetModel.stone-radius * SheetModel.pixels-per-foot;
        width: border-radius * 2.0;
        height: border-radius * 2.0;
        background: stone.color;
        border-width: 2px;
        border-color: black;
    }

    Mark {}

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                Shot.mark-x = (pressed-x - SheetModel.geometry-px.tee-x) / SheetModel.pixels-per-foot;
                Shot.mark-y = pressed-y / SheetModel.pixels-per-foot;
            } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                Shot.clockwise = !Shot.clockwise;
            }
        }
    }
}