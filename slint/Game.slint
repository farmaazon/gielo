import { Functions } from "./Functions.slint";
import { GameModel, Shot, Team } from "GameModel.slint";
import { Sheet } from "Sheet.slint";
import { Button, ComboBox, Slider } from "std-widgets.slint";

StoneWaiting := Rectangle {
    property <Team> team;

    height: width;
    background: team.color;
    border-width: 2px;
    border-color: black;
    border-radius: width / 2.0;
}

TeamStonesWaiting := Rectangle {
    property <Team> team;
    property <int> stones;

    height: 20px;
    min-width: height * 8;

    HorizontalLayout {
        for i in stones: StoneWaiting {
             team: root.team;
             width: root.height;
        }
    }
}

LeftPane := Rectangle {
    property <bool> blinking-stone-visible;

    background: #519ee8;

    VerticalLayout {
        Text {
            text: "End " + GameModel.end;
            vertical-stretch: 0;
        }

        for team[index] in GameModel.teams: TeamStonesWaiting {

            property <bool> delivering: GameModel.current-team == index && GameModel.delivering;

            team: team;
            stones: team.stones-left - (delivering && !blinking-stone-visible ? 1 : 0);
            vertical-stretch: 0;
        }

        Text {
            text: "Strength: " + strength.value;
            vertical-stretch: 0;
        }

        strength := Slider {
            minimum: 2.0;
            maximum: 3.6;
            height: 30px;
            vertical-stretch: 0;
            value <=> Shot.weight-sec;

            changed(v) => {
                value = Functions.round(v, 2);
            }
        }

        Text {
            text: "Rotation:";
            vertical-stretch: 0;
        }

        rotation := Button {
            text: Shot.clockwise ? "Clockwise" : "Counter Clockwise";
            vertical-stretch: 0;

            clicked => { Shot.clockwise = !Shot.clockwise }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        if GameModel.thinking: Button {
            text: "Play";
            vertical-stretch: 0;

            clicked => { GameModel.deliver() }
        }

        if GameModel.end-finished: Button {
            text: "Finish End";
            vertical-stretch: 0;

            clicked => { GameModel.proceed() }
        }

        Rectangle {
            vertical-stretch: 3;
        }

        for team[index] in GameModel.teams: HorizontalLayout {
            vertical-stretch: 0;
            height: 20px;

            Rectangle {
                border-width: 1px;
                border-color: black;
                background: team.color;
            }

            for score in team.end-score: Rectangle {
                border-width: 1px;
                border-color: black;
                background: white;

                Text {
                    text: score;
                }
            }

            Rectangle {
                border-width: 1px;
                border-color: black;
                background: white;

                Text {
                    text: team.score;
                }
            }
        }
    }
}

export Game := Rectangle {
    property <bool> blinking-stone-visible;

    HorizontalLayout {
        Rectangle {
            background: left-pane.background;
        }

        left-pane := LeftPane {
            blinking-stone-visible: root.blinking-stone-visible;
            horizontal-stretch: 0;
        }

        Rectangle {
            background: left-pane.background;
        }

        sheet := Sheet {
            horizontal-stretch: 0;
        }
    }
}