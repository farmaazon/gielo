import { Button, CheckBox, ComboBox, LineEdit, ListView, SpinBox, Slider } from "std-widgets.slint";
import { Functions } from "./Functions.slint";
import { GameModel, NewGameParameters, Player, PlayerSkills, Team } from "./GameModel.slint";
import { Profiles } from "./Profiles.slint";

component TeamLineOut inherits Rectangle {
    in-out property <Team> team;

    callback changed(Team);

    VerticalLayout {
        spacing: 5px;

        HorizontalLayout {
            spacing: 5px;
            Rectangle {
                width: self.height;
                horizontal-stretch: 0;
                background: team.color;
                border-width: 2px;
                border-color: black;
            }

            Text {
                vertical-alignment: center;
                text: "Team";
                horizontal-stretch: 0;
            }

            LineEdit {
                text: team.name;
                edited => {
                    team.name = self.text;
                    changed(team);
                }
                horizontal-stretch: 2;
            }

            team-profile := ComboBox {
                model: Profiles.teams;
                current-index: -1;
                current-value: "Load from profile...";
                horizontal-stretch: 1;

                selected => {
                    root.team.name = Profiles.load-team-name(self.current-index);
                    root.team.players = [];
                    root.team.players = Profiles.load-team-players(self.current-index);
                    root.changed(team);
                    Functions.rebound();
                }
            }
        }

        for player[player-index] in team.players: player-form := HorizontalLayout {
            spacing: 5px;

            Text {
                width: 50px;
                vertical-alignment: center;
                text: player.name + ":";
            }

            VerticalLayout {
                player-profile := ComboBox {
                    model: Profiles.player-skills;
                    current-value: Profiles.custom-player-skills-label(player.skills);

                    selected(profile) => {
                        team.players[player-index].skills = Profiles.load-player-skills(self.current-index);
                        root.changed(team);
                        Functions.rebound();
                    }

                    callback refresh-label();
                    refresh-label => {
                        self.current-index = 0;
                        self.current-value = Profiles.custom-player-skills-label(team.players[player-index].skills);
                    }
                }

                HorizontalLayout {
                    y-std-dev-slider := Slider {
                        value: player.skills.y-std-dev;
                        minimum: 0.0;
                        maximum: 12.0;

                        changed(value) => {
                            self.value = Functions.round(value, 1);
                            team.players[player-index].skills.y-std-dev = self.value;
                            player-profile.refresh-label();
                            root.changed(team);
                        }
                    }

                    x-std-dev-slider := Slider {
                        value: player.skills.x-std-dev;
                        minimum: 0.0;
                        maximum: 6.0;

                        changed(value) => {
                            self.value = Functions.round(value, 1);
                            team.players[player-index].skills.x-std-dev = self.value;
                            player-profile.refresh-label();
                            root.changed(team)
                        }
                    }
                }
            }

            CheckBox {
                text: "left-handed";
                checked: player.left-handed;

                toggled => {
                    team.players[player-index].left-handed = self.checked;
                    root.changed(team)
                }
            }
        }
    }
}

export component NewGame inherits Rectangle {
    in-out property <NewGameParameters> parameters: {
        ends: 8,
        teams: [],
        ice-profile: 0,
        rules-profile: 0,
    };
    callback game-started;
    // background: #519ee8;

    VerticalLayout {
        HorizontalLayout {
            alignment: center;
            spacing: 20px;

            for team[index] in parameters.teams: TeamLineOut {
                width: 400px;
                horizontal-stretch: 0;
                team: team;

                changed(team) => {
                    root.parameters.teams[index] = team;
                }
            }
        }

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                width: 400px;
                padding: 10px;
                spacing: 10px;
                horizontal-stretch: 0;

                Text {
                    text: "Ice profile:";
                }

                ComboBox {
                    model: Profiles.ice;
                    current-index: root.parameters.ice-profile;

                    selected(profile) => {
                        root.parameters.ice-profile = self.current-index;
                    }
                }

                Text {
                    text: "Rule set:";
                }

                ComboBox {
                    model: Profiles.rules;
                    current-index: root.parameters.rules-profile;

                    selected(profile) => {
                        parameters.rules-profile = self.current-index;
                    }
                }

                Text {
                    text: "Ends:";
                }

                ends := SpinBox {
                    minimum: 1;
                    maximum: 20;
                    value: parameters.ends;
                    vertical-stretch: 0;

                    edited(value) => {
                        debug(value);
                        parameters.ends = value;
                    }
                }

                Rectangle {}

                Button {
                    text: "Start!";

                    clicked => {
                        GameModel.start-new-game(root.parameters);
                        root.game-started()
                    }
                }
            }
        }
    }
}